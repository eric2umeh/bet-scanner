# Production store build — set EXPO_PUBLIC_* via `eas secret:create` (see PHASE_14A)
# EXPO_PUBLIC_API_URL=https://bet-scanner-znvg.onrender.com

# Expo web export (./scripts/build_web.sh) served from FastAPI / — leave empty for same-origin:
# EXPO_PUBLIC_API_URL=

# Local Mac API (same Wi‑Fi only; uvicorn --host 0.0.0.0 --port 8000):
# EXPO_PUBLIC_API_URL=http://192.168.x.x:8000

# iOS Simulator:
# EXPO_PUBLIC_API_URL=http://127.0.0.1:8000

# Android emulator:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000

# Phase 12C — Supabase Auth (optional; Project Settings → API)
# EXPO_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Same value as server APP_API_KEY when that is set on Render (baked into web export).
# EXPO_PUBLIC_APP_API_KEY=
