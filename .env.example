# Copy this file to .env and fill in values:
#   cp .env.example .env

# --- App ---
APP_NAME=bet-scanner
APP_ENV=development
DEBUG=true

# --- Database (Supabase cloud — recommended from day one) ---
# 1) Create project at https://supabase.com
# 2) Project Settings → Database → Connection string (URI)
# 3) Paste below, but change "postgresql://" to "postgresql+psycopg://"
#
# Example shape (NOT a real password):
# DATABASE_URL=postgresql+psycopg://postgres.xxxxx:YOUR_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+psycopg://postgres.xxxxx:YOUR_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# --- Football fixtures API (football-data.org — free tier) ---
# 1. Sign up: https://www.football-data.org/client/register
# 2. Copy your token into FOOTBALL_DATA_API_KEY below
FOOTBALL_DATA_API_KEY=your_token_here

# Competitions to sync (comma-separated football-data.org codes)
# PL = Premier League, PD = La Liga, SA = Serie A, BL1 = Bundesliga, FL1 = Ligue 1, CL = Champions League
FOOTBALL_COMPETITIONS=PL,PD,SA,BL1,FL1

# Timezone used when deciding "today"
APP_TIMEZONE=Africa/Lagos