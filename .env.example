# Copy this file to .env and fill in values:
#   cp .env.example .env

# --- App ---
APP_NAME=bet-scanner
APP_ENV=development
DEBUG=true
APP_TIMEZONE=Africa/Lagos

# --- Database (Supabase) ---
# Paste URI from Supabase → Settings → Database
# postgresql://... is fine; the app auto-upgrades it to postgresql+psycopg://
DATABASE_URL=postgresql://postgres.xxxxx:YOUR_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# --- Fixture providers (comma-separated) ---
# football-data = big leagues calendar
# api-football  = today + tomorrow (great for "what's on now")
FIXTURE_PROVIDERS=football-data,api-football

# 1) football-data.org (free) — https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=your_token_here
FOOTBALL_COMPETITIONS=PL,PD,SA,BL1,FL1
SYNC_DAYS_AHEAD=21

# 2) API-Football / API-Sports (free ~100 req/day)
#    https://dashboard.api-football.com/
API_FOOTBALL_KEY=your_api_football_key_here
# empty = major leagues only; "all" = every fixture that day; or "39,140"
API_FOOTBALL_LEAGUE_IDS=

# --- Odds provider: The Odds API (free ~500 req/month) ---
# https://the-odds-api.com/
ODDS_API_KEY=your_odds_api_key_here
ODDS_REGIONS=uk,eu
ODDS_SPORT_KEYS=soccer_epl,soccer_spain_la_liga,soccer_italy_serie_a,soccer_germany_bundesliga,soccer_france_ligue_one
