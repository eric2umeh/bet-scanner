# Copy this file to .env and fill in values:
#   cp .env.example .env

# --- App ---
APP_NAME=bet-scanner
# development locally; production on Render
APP_ENV=development
DEBUG=true
APP_TIMEZONE=Africa/Lagos
# Render sets PORT automatically — do not hardcode it in .env for local use

# Phase 12A — optional shared secret for POST/PUT/PATCH/DELETE (empty = open)
# Set the same value in the Expo app (Me → App access key) and web dashboard.
# Use header X-API-Key only (Bearer is for user login).
APP_API_KEY=

# --- Database (Supabase) ---
DATABASE_URL=postgresql://postgres.xxxxx:YOUR_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Phase 12C — Supabase Auth (optional)
# Project Settings → API → URL, anon public key, JWT Secret
# Server .env: powers web Me → Account via GET /auth/config
# mobile/.env: EXPO_PUBLIC_SUPABASE_URL + EXPO_PUBLIC_SUPABASE_ANON_KEY (same values)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
# true = tip writes need a signed-in user (only after JWT secret is set)
AUTH_REQUIRED_FOR_TIPS=false

# --- Fixture providers ---
# odds-api-io = SportyBet/Bet9ja pending events (recommended). Optional: football-data
FIXTURE_PROVIDERS=odds-api-io
API_FOOTBALL_ENABLED=false
FOOTBALL_DATA_API_KEY=your_token_here
FOOTBALL_COMPETITIONS=PL,PD,SA,BL1,FL1
SYNC_DAYS_AHEAD=21
API_FOOTBALL_KEY=your_api_football_key_here
API_FOOTBALL_LEAGUE_IDS=

# --- Odds sync (Phase 3B) ---
# Master switch: false = no external odds calls
ODDS_SYNC_ENABLED=false
# Free NG path: odds-api-io | also: the-odds-api, betrelay
# For more arb books, combine providers (same odds table):
#   ODDS_PROVIDERS=odds-api-io,the-odds-api
# odds-api.io → SportyBet, 1xBet (your NG books). the-odds-api → Bet365, Pinnacle, etc. (UK/EU, ~500 req/mo free).
ODDS_PROVIDERS=odds-api-io

# Odds-API.io FREE (SportyBet + Bet9ja) — https://odds-api.io
ODDS_API_IO_KEY=your_odds_api_io_key_here
# Must match your 2 books on odds-api.io (use lowercase 1xbet in API calls)
ODDS_API_IO_BOOKMAKERS=SportyBet,MelBet
ODDS_API_IO_EVENT_LIMIT=40

# The Odds API (UK/EU credits) — keep out of ODDS_PROVIDERS while testing
ODDS_API_KEY=your_odds_api_key_here
ODDS_REGIONS=uk,eu
ODDS_SPORT_KEYS=soccer_epl,soccer_spain_la_liga,soccer_italy_serie_a,soccer_germany_bundesliga,soccer_france_ligue_one

# BetRelay (optional / usually paid) — https://betrelay.com.ng/api-docs
BETRELAY_API_KEY=
BETRELAY_MATCH_LIMIT=10

# --- Phase 3A: Arbitrage ---
ARB_MIN_PROFIT_PCT=0.3
ARB_MAX_ODDS_AGE_MINUTES=180
ARB_MIN_ODDS=1.01
ARB_MAX_ODDS=15.0
ARB_STAKE_ROUND_TO=100

# --- Phase 3C: Bankroll + Safe Builder ---
BANKROLL_UNIT_PCT=1
SAFE_DOG_HIGH=6
SAFE_DOG_FLEX=10
SAFE_FAV_MAX_FLEX=1.50
# Default pick style: double_chance | 1x2 (dashboard/API can override)
SAFE_PICK_MARKET=double_chance
SAFE_HIDE_WEAK_PICKS=true
GOAL_LEAN_MIN_CONFIDENCE=60

# --- Phase 4: Telegram (optional) ---
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Phase 5A: Value / EV (cross-book de-vig) ---
VALUE_MIN_EV_PCT=1.5
VALUE_MIN_BOOKS=2
VALUE_KELLY_FRACTION=0.25

# --- Phase 5B: AI explain (optional OpenAI-compatible) ---
AI_ENABLED=false
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# --- Phase 7: Daily ops ---
OPS_DEFAULT_BANKROLL_NGN=50000
OPS_BRIEF_MAX_EXPLAINS=3
